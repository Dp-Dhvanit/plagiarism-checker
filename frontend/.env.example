# Copy to .env.local (git-ignored by Vite's default .gitignore) to override.
#
# Only used for the "open API docs" link in the top bar — every actual API
# call in src/lib/api.js goes to same-origin relative paths, proxied to the
# backend by vite.config.js's dev-server proxy (see server.proxy there).
VITE_API_BASE=http://127.0.0.1:8000
