# Copy this file to .env and fill in your own key. Never commit the real .env file.

# LM Studio — a local server (Settings > Local Server in the app) that
# speaks the same /v1/chat/completions format as OpenAI. If set, the Summary
# feature's semantic layer uses your local model FIRST — free, offline, no
# daily cap — and only falls back to Gemini below if the local call fails.
# Start the server in LM Studio, load a model, then set its exact model id
# here (shown in LM Studio's server tab, e.g. "qwen2.5-7b-instruct").
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Required to enable the Gemini semantic summary layer (used as a fallback
# when LM Studio above isn't configured, or its call fails). If neither is
# set, the Summary feature falls back to the existing deterministic
# summary — the app works fine without either, just without the AI-enhanced
# overview.
#
# The free tier caps each key at 20 requests/day for the Flash model
# (measured — see IMPROVEMENTS.md). You may set this to a COMMA-SEPARATED
# list of keys from different Google accounts, each with its own
# independent quota; every Gemini call (text detection, image detection,
# and the summary layer) automatically falls back to the next key once
# one hits 429 RESOURCE_EXHAUSTED, rather than failing outright.
#   GEMINI_API_KEY=key_one,key_two,key_three
GEMINI_API_KEY=

# Optional. Cost-efficient Flash-Lite model for the semantic summary layer.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used by the AI-generated-text detector (Feature 1) and the AI image
# detector (Feature 2) — these use the full Flash model rather than the
# Lite model above, since they need stronger reasoning/multimodal quality.
# Falls back to the same GEMINI_API_KEY above; no separate key needed.
GEMINI_MODEL_FLASH=gemini-3.6-flash

# NOTE ON MODEL RETIREMENT
# Google retires model versions. A retired name fails with HTTP 404 and the
# error names its replacement — the backend logs that error in full, so
# check the terminal if AI-assisted features stop working, then update the
# two names above. To avoid version pinning entirely you can instead use
# the rolling aliases, at the cost of the model changing under you:
#   GEMINI_MODEL=gemini-flash-lite-latest
#   GEMINI_MODEL_FLASH=gemini-flash-latest

# ── Additional detectors — ALL FREE, all optional ────────────────────────
# Every provider below costs nothing. They run in PARALLEL with Gemini and
# the local scorer, and the result reports where they agree or disagree.
# Leave any of them blank and it is simply skipped.

# Groq — no credit card. The binding limit is 200,000 tokens/day, which at
# this project's ~2,000 tokens/call works out to roughly 100 analyses/day —
# still ~5x Gemini's 20/day, just not the 1,000/day the old Llama models
# once offered before Groq retired them from the free tier.
# Key: https://console.groq.com/keys · Models: https://console.groq.com/docs/models
#   (check that link before assuming a model id below still exists — Groq's
#   free-tier lineup changes; this project already hit one 404 from it)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — free rotating model pool (note the ":free" suffix).
# Availability changes; a 404 means "pick another free model", not a bug.
# Key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — fully local, unlimited, offline, no key and no cap at all.
# Install Ollama, run `ollama pull llama3.2`, then set the model name here.
# Lower quality than the hosted 70B models, but it never runs out.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# NOT enabled: xAI / Grok. app/detectors/grok.py works and is kept as a
# worked example, but xAI has NO free tier — only $25 of metered credit.
# To use it anyway, set XAI_API_KEY and add GrokDetector() to _REGISTRY.
# XAI_API_KEY=
# GROK_MODEL=grok-4.1-fast

# Free OpenRouter fallback for image AI-detection, used only when Gemini is
# unavailable or fails — see app/image_detector.py. Deliberately pinned
# (not the openrouter/free auto-router alias): a live check found the
# auto-router can resolve a vision request to a content-safety classifier
# rather than a real image-understanding model. Availability rotates like
# every other OpenRouter free model — check openrouter.ai/models if this
# one stops working.
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Any other OpenAI-compatible provider (Together, DeepSeek, LM Studio) is a
# ~10-line subclass of app/detectors/openai_compat.py — see free_providers.py.

# Ceiling (seconds) for the whole parallel batch of hosted second-opinion
# detectors in one /analyze call — a backstop only, not a per-provider
# timeout (each provider enforces its own already). Default 60.
# DETECTOR_TIMEOUT_S=60

# Experimental local cross-perplexity detector. DISABLED by default because
# benchmarking showed it does not separate human from AI text at CPU model
# scale — see app/detectors/binoculars.py for the measurements.
# ENABLE_BINOCULARS=1

# Local sentence-embedding model for the similarity/plagiarism pipeline.
# Runs fully offline (downloaded once from Hugging Face on first use) —
# not a Gemini/API call, no extra cost or rate limit.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum accepted upload size, in megabytes, for document uploads.
MAX_UPLOAD_MB=15

# Who may talk to this API from a browser. The bundled frontend reaches it
# through Vite's same-origin proxy, so the defaults below are all it needs.
# Only change these if you serve the UI from somewhere else:
#   CORS_ORIGINS  - origins allowed to call the API cross-origin
#   ALLOWED_HOSTS - Host headers accepted (blocks DNS-rebinding). If you open the
#                   dev server by LAN IP or a domain, add it here or every
#                   request will be answered with "Invalid host header".
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_HOSTS=localhost,127.0.0.1

# Optional external-source plagiarism check (Wikipedia + arXiv abstracts). Only runs
# when the user ticks the box on a scan, and sends a few short excerpts of the text
# to those sites as search queries. Set to "off" to make that impossible.
# EXTERNAL_SOURCES=wikipedia,arxiv
# Wikimedia asks API clients to identify themselves; an email or URL here is polite
# and reduces throttling (429s) from Wikipedia.
# EXTERNAL_SOURCES_CONTACT=you@example.com
